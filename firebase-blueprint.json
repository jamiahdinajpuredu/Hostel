{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student information",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "name": { "type": "string" },
        "roomNumber": { "type": "string" },
        "className": { "type": "string" }
      },
      "required": ["studentId", "name"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Individual meal attendance record",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "mealType": { "type": "string", "enum": ["Breakfast", "Lunch", "Dinner"] },
        "status": { "type": "string", "enum": ["Present", "Absent"] },
        "timestamp": { "type": "string" },
        "recordedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "date", "mealType", "status"]
    },
    "User": {
      "title": "User",
      "description": "System user profile",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Staff", "Viewer"] }
      },
      "required": ["username", "role"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global configuration",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Students list"
    },
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/settings/config": {
      "schema": "AppSettings",
      "description": "App configuration"
    }
  }
}
