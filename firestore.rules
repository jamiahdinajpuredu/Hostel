rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      // In this environment, we should check email verification if applicable, 
      // but for simplicity with Google Login we check existence
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (
        getRole(request.auth.uid) == 'Admin' || 
        request.auth.token.email == 'jamiahdinajpur.edu@gmail.com'
      );
    }
    
    function isStaff() {
      return isSignedIn() && (isAdmin() || getRole(request.auth.uid) == 'Staff');
    }

    function isViewer() {
      return isSignedIn() && (isStaff() || getRole(request.auth.uid) == 'Viewer');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidStudent(data) {
      return data.keys().hasAll(['studentId', 'name']) &&
             data.studentId is string && data.studentId.size() <= 50 &&
             data.name is string && data.name.size() <= 200 &&
             (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() <= 50)) &&
             (!('className' in data) || (data.className is string && data.className.size() <= 50));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['studentId', 'date', 'mealType', 'status']) &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.mealType in ['Breakfast', 'Lunch', 'Dinner'] &&
             data.status in ['Present', 'Absent'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'role']) &&
             data.username is string && data.username.size() <= 128 &&
             data.role in ['Admin', 'Staff', 'Viewer'];
    }

    // --- Rules ---

    match /students/{studentId} {
      allow read: if isViewer();
      allow write: if isAdmin() && isValidStudent(incoming());
    }

    match /attendance/{recordId} {
      allow read: if isViewer();
      allow create: if isStaff() && isValidAttendance(incoming());
      allow update: if isStaff() && isValidAttendance(incoming()) && (
        // Only allow updating status and timestamp/updatedAt
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timestamp', 'updatedAt', 'recordedBy'])
      );
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isViewer();
      // Allow bootstrap: any user can create their own profile IF no users exist yet or if they match the admin email
      allow create: if (isAdmin() || (isSignedIn() && userId == request.auth.uid)) && isValidUser(incoming());
      allow update: if isAdmin() && isValidUser(incoming());
      allow delete: if isAdmin();
    }
  }
}
