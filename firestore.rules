rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStudent(data) {
      return data.studentId is string && data.studentId.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.roomNumber is string && data.roomNumber.size() <= 50 &&
             data.className is string && data.className.size() <= 50;
    }

    function isValidAttendance(data) {
      return data.studentId is string && data.studentId.size() <= 100 &&
             data.date is string && data.date.size() == 10 &&
             data.mealType in ['Breakfast', 'Lunch', 'Dinner'] &&
             data.status in ['Present', 'Absent'];
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jamiahdinajpur.edu@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    function isStaff() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Staff']);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isStaff() && isValidStudent(incoming());
    }

    // Attendance collection
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isStaff() && isValidAttendance(incoming());
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      // Allow creation of the first admin account with the specific bootstrap email
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'admin@hostel.internal' && incoming().role == 'Admin');
    }

    // Settings collection
    match /settings/config {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
