{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student record in the hostel.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "name": { "type": "string" },
        "roomNumber": { "type": "string" },
        "className": { "type": "string" }
      },
      "required": ["studentId", "name", "roomNumber", "className"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Log of student attendance for a specific meal.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "date": { "type": "string" },
        "mealType": { "type": "string", "enum": ["Breakfast", "Lunch", "Dinner"] },
        "status": { "type": "string", "enum": ["Present", "Absent"] },
        "timestamp": { "type": "string" },
        "recordedBy": { "type": "string" }
      },
      "required": ["studentId", "date", "mealType", "status"]
    },
    "User": {
      "title": "User",
      "description": "System user (Admin or Staff).",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["Admin", "Staff"] }
      },
      "required": ["username", "name", "role"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application configuration.",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all students."
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance logs."
    },
    "/users/{username}": {
      "schema": "User",
      "description": "Collection of system users. Username is the document ID."
    },
    "/settings/config": {
      "schema": "AppSettings",
      "description": "Single document for app settings."
    }
  }
}
